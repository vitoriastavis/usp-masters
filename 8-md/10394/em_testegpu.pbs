#!/bin/bash
#PBS -N em_10394_testegpu
#PBS -q testegpu
#PBS -l walltime=00:30:00
#PBS -j oe

cd "$PBS_O_WORKDIR" || exit 1

module load gromacs/nvidia-ngc

export OMP_NUM_THREADS=4

$nv_gromacs gmx grompp \
    -f inputs/minim.mdp \
    -c solv_ions.gro \
    -p topol.top \
    -o em_testegpu.tpr \
    -po mdout_testegpu.mdp \
    > grompp_em_testegpu.log 2>&1 || exit 1

$nv_gromacs gmx mdrun \
    -deffnm em_testegpu \
    -ntmpi 2 \
    -ntomp 4 \
    -nb gpu \
    -pme cpu \
    -pin on \
    -v
