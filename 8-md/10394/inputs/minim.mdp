; Energy minimization
integrator      = steep
emtol           = 500.0
emstep          = 0.01
nsteps          = 50000

; Neighbor searching
cutoff-scheme   = Verlet
nstlist         = 1

; Electrostatics
coulombtype     = PME
rcoulomb        = 1.2

; Van der Waals
vdwtype         = PME
rvdw            = 1.2
lj-pme-comb-rule = Geometric
DispCorr        = no

; Constraints
constraints     = none

; Boundary conditions
pbc             = xyz
