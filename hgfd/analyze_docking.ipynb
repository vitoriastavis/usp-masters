    "# ---- per ligand mean/std ----\n",
    "summary = (\n",
    "    df.groupby([\"protein\", \"ligand\"])\n",
    "      .agg(mean_affinity=(\"affinity\", \"mean\"),\n",
    "           std_affinity=(\"affinity\", \"std\"),\n",
    "           n=(\"affinity\", \"count\"))\n",
    "      .reset_index()\n",
    ")"
   ]
  },
