    "]\n",
    "\n",
    "# Media e desvio padrao da afinidade dos ligantes para cada estrutura da PDE4B\n",
    "media_pde4b = (\n",
    "    summary_1rep_18\n",
    "    .groupby(\"protein\", as_index=False)\n",
    "    .agg(\n",
