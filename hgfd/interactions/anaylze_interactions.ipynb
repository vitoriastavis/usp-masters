   "source": [
    "## Interaction fingerprint (IFP) analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "645265c7",
   "metadata": {},
   "outputs": [],
   "source": [
    "fp_ligand = (\n",
    "    df_lig.assign(value=1)\n",
    "          .pivot_table(\n",
    "              index=\"ligand\",\n",
    "              columns=\"residue_id\",\n",
    "              values=\"value\",\n",
    "              aggfunc=\"max\",\n",
    "              fill_value=0\n",
    "          )\n",
    ")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "13b551e2",
   "metadata": {},
   "outputs": [],
   "source": [
    "known = [\"rolR\", \"rf\", \"rolS\"]\n",
    "\n",
    "known_fp = fp_ligand.loc[known]\n",
    "\n",
    "shared = known_fp.sum(axis=0) == len(known)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "27647716",
   "metadata": {},
   "source": [
    "### Clustering"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "d3c0a05a",
   "metadata": {},
   "outputs": [],
   "source": [
    "fp = (\n",
    "    df_lig.assign(value=1)\n",
    "           .pivot_table(\n",
    "               index=[\"protein\", \"ligand\"],\n",
    "               columns=\"residue_id\",\n",
    "               values=\"value\",\n",
    "               aggfunc=\"max\",\n",
    "               fill_value=0\n",
    "           )\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "ee1c99eb",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1800x600 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "from scipy.spatial.distance import pdist\n",
    "from scipy.cluster.hierarchy import linkage, dendrogram\n",
    "\n",
    "distance = pdist(fp.values, metric=\"jaccard\")\n",
    "\n",
    "Z = linkage(distance, method=\"average\")\n",
    "\n",
    "plt.figure(figsize=(18,6))\n",
    "\n",
    "dendrogram(\n",
    "    Z,\n",
    "    labels=[f\"{p}:{l}\" for p, l in fp.index],\n",
    "    leaf_rotation=90\n",
    ")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
