   "id": "bc92434a",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create residue ID: residue name + residue number + chain\n",
    "df[\"residue_id\"] = (\n",
    "    df[\"restype\"].astype(str) +\n",
    "    df[\"resnr\"].astype(\"Int64\").astype(str) +\n",
    "    \":\" +\n",
    "    df[\"reschain\"].astype(str)\n",
    ")\n",
    "\n",
    "# Save\n",
    "df.to_csv(\"plip_interactions.csv\", index=False)"
   ]
  },
