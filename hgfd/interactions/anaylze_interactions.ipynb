   "source": [
    "import os\n",
    "import pandas as pd\n",
    "from plip.structure.preparation import PDBComplex\n",
    "\n",
    "# Configuration\n",
    "proteins = [\n",
    "    \"PDE4B_catalytic\",\n",
    "    \"PDE4B_monomer\",\n",
    "    \"PDE4B_dimer\",\n",
    "    \"PDE4D_catalytic\",\n",
    "    \"PDE4D_monomer\",\n",
    "    \"PDE4D_dimer\",\n",
    "]\n",
    "interaction_types = [\n",
    "    \"hydrophobic_contacts\",\n",
    "    \"hbonds_ldon\",\n",
    "    \"hbonds_pdon\",\n",
    "    \"water_bridges\",\n",
    "    \"saltbridge_lneg\",\n",
    "    \"saltbridge_pneg\",\n",
    "    \"pistacking\",\n",
    "    \"pication_laro\",\n",
    "    \"pication_paro\",\n",
    "    \"halogen_bonds\",\n",
    "    \"metal_complexes\",\n",
    "]\n",
    "\n",
    "pdb_folder = \"../pdbs\"\n",
    "\n",
    "# Helper functions\n",
    "def get_attr(obj, *names):\n",
    "    \"\"\"\n",
    "    Return the first existing attribute from names.\n",
    "    Returns None if none exists.\n",
    "    \"\"\"\n",
    "    for name in names:\n",
    "        if hasattr(obj, name):\n",
    "            return getattr(obj, name)\n",
    "    return None\n",
    "\n",
    "def atom_idx(atom):\n",
    "    \"\"\"\n",
    "    Extract an atom index if the object is an OpenBabel atom.\n",
    "    \"\"\"\n",
    "    if atom is None:\n",
    "        return None\n",
    "\n",
    "    try:\n",
    "        return atom.idx\n",
    "    except Exception:\n",
    "        return None\n",
    "\n",
    "def atom_coords(atom):\n",
    "    \"\"\"\n",
    "    Extract XYZ coordinates from an OpenBabel atom.\n",
    "    \"\"\"\n",
    "    if atom is None:\n",
    "        return None\n",
    "\n",
    "    try:\n",
    "        return (\n",
    "            atom.coords[0],\n",
    "            atom.coords[1],\n",
    "            atom.coords[2],\n",
    "        )\n",
    "    except Exception:\n",
    "        return None\n",
    "\n",
    "def clean_value(value):\n",
    "    \"\"\"\n",
    "    Convert numpy scalar values to normal Python values.\n",
    "    Keep tuples/lists as they are.\n",
    "    \"\"\"\n",
    "    if value is None:\n",
    "        return None\n",
    "\n",
    "    try:\n",
    "        if hasattr(value, \"item\"):\n",
    "            return value.item()\n",
    "    except Exception:\n",
    "        pass\n",
    "\n",
    "    return value\n",
    "\n",
    "rows = []\n",
    "# Process PDB files\n",
    "for pdb_file in sorted(os.listdir(pdb_folder)):\n",
    "\n",
    "    if not pdb_file.endswith(\".pdb\"):\n",
    "        continue\n",
    "\n",
    "    basename = os.path.splitext(pdb_file)[0]\n",
    "\n",
    "    # Identify protein and ligand from filename\n",
    "    protein = None\n",
    "    ligand = None\n",
    "\n",
    "    # Longest first to avoid partial matches\n",
    "    for p in sorted(proteins, key=len, reverse=True):\n",
    "        if basename.startswith(p + \"_\"):\n",
    "            protein = p\n",
    "            ligand = basename[len(p) + 1:]\n",
    "            break\n",
    "\n",
    "    if protein is None:\n",
    "        print(f\"Skipping {pdb_file}: protein not recognized.\")\n",
    "        continue\n",
    "\n",
    "    print(pdb_file)\n",
    "\n",
    "    pdb_path = os.path.join(pdb_folder, pdb_file)\n",
    "    mol = PDBComplex()\n",
    "    mol.load_pdb(pdb_path)\n",
    "    mol.analyze()\n",
    "\n",
    "    # Iterate over binding sites\n",
    "    for bsid, inter in mol.interaction_sets.items():\n",
    "\n",
    "        for itype in interaction_types:\n",
    "\n",
    "            interactions = getattr(inter, itype, [])\n",
    "\n",
    "            if not interactions:\n",
    "                continue\n",
    "\n",
    "            # Each PLIP interaction\n",
    "            for i in interactions:\n",
    "\n",
    "                row = {\n",
    "                    # Dataset identifiers\n",
    "                    \"protein\": protein,\n",
    "                    \"ligand\": ligand,\n",
    "                    \"binding_site\": bsid,\n",
    "                    \"interaction_type\": itype,\n",
    "\n",
    "                    # Common interaction information\n",
    "                    \"resnr\": get_attr(i, \"resnr\"),\n",
    "                    \"restype\": get_attr(i, \"restype\"),\n",
    "                    \"reschain\": get_attr(i, \"reschain\"),\n",
    "\n",
    "                    \"resnr_lig\": get_attr(i, \"resnr_lig\"),\n",
    "                    \"restype_lig\": get_attr(i, \"restype_lig\"),\n",
    "                    \"reschain_lig\": get_attr(i, \"reschain_lig\"),\n",
    "\n",
    "                    \"dist\": clean_value(\n",
    "                        get_attr(i, \"dist\", \"distance\")\n",
    "                    ),\n",
    "\n",
    "                    # Coordinates\n",
    "                    \"ligcoo\": get_attr(i, \"ligcoo\"),\n",
    "                    \"protcoo\": get_attr(i, \"protcoo\"),\n",
    "\n",
    "                    # Hydrogen bonds\n",
    "                    \"sidechain\": get_attr(i, \"sidechain\"),\n",
    "\n",
    "                    \"dist_h-a\": clean_value(\n",
    "                        get_attr(i, \"dist_h-a\", \"dist_h_a\")\n",
    "                    ),\n",
    "\n",
    "                    \"dist_d-a\": clean_value(\n",
    "                        get_attr(i, \"dist_d-a\", \"dist_d_a\")\n",
    "                    ),\n",
    "\n",
    "                    \"don_angle\": clean_value(\n",
    "                        get_attr(i, \"don_angle\")\n",
    "                    ),\n",
    "\n",
    "                    \"protisdon\": get_attr(i, \"protisdon\"),\n",
    "\n",
    "                    \"donoridx\": get_attr(\n",
    "                        i, \"donoridx\", \"don_idx\"\n",
    "                    ),\n",
    "\n",
    "                    \"donortype\": get_attr(\n",
    "                        i, \"donortype\"\n",
    "                    ),\n",
    "\n",
    "                    \"acceptoridx\": get_attr(\n",
    "                        i, \"acceptoridx\", \"acc_idx\"\n",
    "                    ),\n",
    "\n",
    "                    \"acceptortype\": get_attr(\n",
    "                        i, \"acceptortype\"\n",
    "                    ),\n",
    "\n",
    "                    # Water bridges\n",
    "                    \"dist_a-w\": clean_value(\n",
    "                        get_attr(i, \"dist_a-w\", \"dist_a_w\")\n",
    "                    ),\n",
    "\n",
    "                    \"dist_d-w\": clean_value(\n",
    "                        get_attr(i, \"dist_d-w\", \"dist_d_w\")\n",
    "                    ),\n",
    "\n",
    "                    \"water_angle\": clean_value(\n",
    "                        get_attr(i, \"water_angle\")\n",
    "                    ),\n",
    "\n",
    "                    \"water_idx\": get_attr(\n",
    "                        i, \"water_idx\"\n",
    "                    ),\n",
    "\n",
    "                    # Halogen bonds\n",
    "                    \"acc_angle\": clean_value(\n",
    "                        get_attr(i, \"acc_angle\")\n",
    "                    ),\n",
    "\n",
    "                    # Salt bridges\n",
    "                    \"protispos\": get_attr(\n",
    "                        i, \"protispos\"\n",
    "                    ),\n",
    "\n",
    "                    \"lig_group\": get_attr(\n",
    "                        i, \"lig_group\"\n",
    "                    ),\n",
    "\n",
    "                    \"lig_idx_list\": get_attr(\n",
    "                        i, \"lig_idx_list\"\n",
    "                    ),\n",
    "\n",
    "                    # Pi interactions\n",
    "                    \"cent_dist\": clean_value(\n",
    "                        get_attr(i, \"cent_dist\")\n",
    "                    ),\n",
    "\n",
    "                    \"angle\": clean_value(\n",
    "                        get_attr(i, \"angle\")\n",
    "                    ),\n",
    "\n",
    "                    \"offset\": clean_value(\n",
    "                        get_attr(i, \"offset\")\n",
    "                    ),\n",
    "\n",
    "                    \"type\": get_attr(i, \"type\"),\n",
    "\n",
    "                    \"protcharged\": get_attr(\n",
    "                        i, \"protcharged\"\n",
    "                    ),\n",
    "\n",
    "                    # Metal complexes\n",
    "                    \"metalcoo\": get_attr(\n",
    "                        i, \"metalcoo\"\n",
    "                    ),\n",
    "\n",
    "                    \"targetcoo\": get_attr(\n",
    "                        i, \"targetcoo\"\n",
    "                    ),\n",
    "\n",
    "                    \"metal_idx\": get_attr(\n",
    "                        i, \"metal_idx\"\n",
    "                    ),\n",
    "\n",
    "                    \"metal_type\": get_attr(\n",
    "                        i, \"metal_type\"\n",
    "                    ),\n",
    "\n",
    "                    \"target_idx\": get_attr(\n",
    "                        i, \"target_idx\"\n",
    "                    ),\n",
    "\n",
    "                    \"target_type\": get_attr(\n",
    "                        i, \"target_type\"\n",
    "                    ),\n",
    "\n",
    "                    \"coordination\": get_attr(\n",
    "                        i, \"coordination\",\n",
    "                        \"coordination_num\"\n",
    "                    ),\n",
    "\n",
    "                    \"location\": get_attr(\n",
    "                        i, \"location\"\n",
    "                    ),\n",
    "\n",
    "                    \"rms\": clean_value(\n",
    "                        get_attr(i, \"rms\")\n",
    "                    ),\n",
    "\n",
    "                    \"geometry\": get_attr(\n",
    "                        i, \"geometry\"\n",
    "                    ),\n",
    "\n",
    "                    \"complexnum\": get_attr(\n",
    "                        i, \"complexnum\"\n",
    "                    ),\n",
    "                }\n",
    "\n",
    "                rows.append(row)\n",
    "\n",
    "df = pd.DataFrame(rows)\n",
    "for col in [\"ligcoo\", \"protcoo\", \"metalcoo\", \"targetcoo\"]:\n",
    "\n",
    "    if col in df.columns:\n",
    "        df[col] = df[col].apply(\n",
    "            lambda x: tuple(x) if x is not None else None\n",
    "        )\n",
    "\n",
    "# Save\n",
    "df.to_csv(\"plip_interactions.csv\", index=False)\n",
    "\n",
    "print(\"\\nDone.\")\n",
    "print(\"Shape:\", df.shape)\n",
    "print(\"\\nInteraction counts:\")\n",
    "print(df[\"interaction_type\"].value_counts())\n",
    "\n",
    "print(\"\\nProtein counts:\")\n",
    "print(df[\"protein\"].value_counts())"
   ]
  },
