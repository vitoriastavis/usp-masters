    "import os\n",
    "import pandas as pd\n",
    "from concurrent.futures import ProcessPoolExecutor, as_completed\n",
    "from plip.structure.preparation import PDBComplex\n",
    "\n",
    "# Configuration\n",
    "proteins = [\n",
    "    \"PDE4B_catalytic\",\n",
    "    \"PDE4B_monomer\",\n",
    "    \"PDE4B_dimer\",\n",
    "    \"PDE4D_catalytic\",\n",
    "    \"PDE4D_monomer\",\n",
    "    \"PDE4D_dimer\",\n",
    "]\n",
    "interaction_types = [\n",
    "    \"hydrophobic_contacts\",\n",
    "    \"hbonds_ldon\",\n",
    "    \"hbonds_pdon\",\n",
    "    \"water_bridges\",\n",
    "    \"saltbridge_lneg\",\n",
    "    \"saltbridge_pneg\",\n",
    "    \"pistacking\",\n",
    "    \"pication_laro\",\n",
    "    \"pication_paro\",\n",
    "    \"halogen_bonds\",\n",
    "    \"metal_complexes\",\n",
    "]\n",
    "\n",
    "pdb_folder = \"../pdbs\"\n",
    "\n",
    "# os.cpu_count().\n",
    "N_WORKERS = None\n",
    "\n",
    "# Helper functions\n",
    "def get_attr(obj, *names):\n",
    "    for name in names:\n",
    "        if hasattr(obj, name):\n",
    "            return getattr(obj, name)\n",
    "    return None\n",
    "\n",
    "\n",
    "def clean_value(value):\n",
    "    if value is None:\n",
    "        return None\n",
    "    try:\n",
    "        if hasattr(value, \"item\"):\n",
    "            return value.item()\n",
    "    except Exception:\n",
    "        pass\n",
    "    return value\n",
    "\n",
    "\n",
    "def identify_protein_ligand(basename):\n",
    "    for p in sorted(proteins, key=len, reverse=True):\n",
    "        if basename.startswith(p + \"_\"):\n",
    "            return p, basename[len(p) + 1:]\n",
    "    return None, None\n",
    "\n",
    "# Per-file worker: this is what gets sent to each process\n",
    "def process_pdb_file(pdb_file):\n",
    "    basename = os.path.splitext(pdb_file)[0]\n",
    "    protein, ligand = identify_protein_ligand(basename)\n",
    "\n",
    "    if protein is None:\n",
    "        return pdb_file, []  # skipped\n",
    "\n",
    "    pdb_path = os.path.join(pdb_folder, pdb_file)\n",
    "    mol = PDBComplex()\n",
    "    mol.load_pdb(pdb_path)\n",
    "    mol.analyze()\n",
    "\n",
    "    rows = []\n",
    "    for bsid, inter in mol.interaction_sets.items():\n",
    "        for itype in interaction_types:\n",
    "            interactions = getattr(inter, itype, [])\n",
    "            if not interactions:\n",
    "                continue\n",
    "\n",
    "            for i in interactions:\n",
    "                row = {\n",
    "                    \"protein\": protein,\n",
    "                    \"ligand\": ligand,\n",
    "                    \"binding_site\": bsid,\n",
    "                    \"interaction_type\": itype,\n",
    "\n",
    "                    \"resnr\": get_attr(i, \"resnr\"),\n",
    "                    \"restype\": get_attr(i, \"restype\"),\n",
    "                    \"reschain\": get_attr(i, \"reschain\"),\n",
    "\n",
    "                    \"resnr_lig\": get_attr(i, \"resnr_lig\"),\n",
    "                    \"restype_lig\": get_attr(i, \"restype_lig\"),\n",
    "                    \"reschain_lig\": get_attr(i, \"reschain_lig\"),\n",
    "\n",
    "                    \"dist\": clean_value(get_attr(i, \"dist\", \"distance\")),\n",
    "\n",
    "                    \"ligcoo\": get_attr(i, \"ligcoo\"),\n",
    "                    \"protcoo\": get_attr(i, \"protcoo\"),\n",
    "\n",
    "                    \"sidechain\": get_attr(i, \"sidechain\"),\n",
    "                    \"dist_h-a\": clean_value(get_attr(i, \"dist_h-a\", \"dist_h_a\")),\n",
    "                    \"dist_d-a\": clean_value(get_attr(i, \"dist_d-a\", \"dist_d_a\")),\n",
    "                    \"don_angle\": clean_value(get_attr(i, \"don_angle\")),\n",
    "                    \"protisdon\": get_attr(i, \"protisdon\"),\n",
    "                    \"donoridx\": get_attr(i, \"donoridx\", \"don_idx\"),\n",
    "                    \"donortype\": get_attr(i, \"donortype\"),\n",
    "                    \"acceptoridx\": get_attr(i, \"acceptoridx\", \"acc_idx\"),\n",
    "                    \"acceptortype\": get_attr(i, \"acceptortype\"),\n",
    "\n",
    "                    \"dist_a-w\": clean_value(get_attr(i, \"dist_a-w\", \"dist_a_w\")),\n",
    "                    \"dist_d-w\": clean_value(get_attr(i, \"dist_d-w\", \"dist_d_w\")),\n",
    "                    \"water_angle\": clean_value(get_attr(i, \"water_angle\")),\n",
    "                    \"water_idx\": get_attr(i, \"water_idx\"),\n",
    "\n",
    "                    \"acc_angle\": clean_value(get_attr(i, \"acc_angle\")),\n",
    "\n",
    "                    \"protispos\": get_attr(i, \"protispos\"),\n",
    "                    \"lig_group\": get_attr(i, \"lig_group\"),\n",
    "                    \"lig_idx_list\": get_attr(i, \"lig_idx_list\"),\n",
    "\n",
    "                    \"cent_dist\": clean_value(get_attr(i, \"cent_dist\")),\n",
    "                    \"angle\": clean_value(get_attr(i, \"angle\")),\n",
    "                    \"offset\": clean_value(get_attr(i, \"offset\")),\n",
    "                    \"type\": get_attr(i, \"type\"),\n",
    "                    \"protcharged\": get_attr(i, \"protcharged\"),\n",
    "\n",
    "                    \"metalcoo\": get_attr(i, \"metalcoo\"),\n",
    "                    \"targetcoo\": get_attr(i, \"targetcoo\"),\n",
    "                    \"metal_idx\": get_attr(i, \"metal_idx\"),\n",
    "                    \"metal_type\": get_attr(i, \"metal_type\"),\n",
    "                    \"target_idx\": get_attr(i, \"target_idx\"),\n",
    "                    \"target_type\": get_attr(i, \"target_type\"),\n",
    "                    \"coordination\": get_attr(i, \"coordination\", \"coordination_num\"),\n",
    "                    \"location\": get_attr(i, \"location\"),\n",
    "                    \"rms\": clean_value(get_attr(i, \"rms\")),\n",
    "                    \"geometry\": get_attr(i, \"geometry\"),\n",
    "                    \"complexnum\": get_attr(i, \"complexnum\"),\n",
    "                }\n",
    "                rows.append(row)\n",
    "\n",
    "    return pdb_file, rows\n",
    "\n",
    "# Main: dispatch files to a process pool\n",
    "def main():\n",
    "    pdb_files = sorted(f for f in os.listdir(pdb_folder) if f.endswith(\".pdb\"))\n",
    "\n",
    "    all_rows = []\n",
    "    with ProcessPoolExecutor(max_workers=N_WORKERS) as executor:\n",
    "        futures = {executor.submit(process_pdb_file, f): f for f in pdb_files}\n",
    "\n",
    "        for future in as_completed(futures):\n",
    "            pdb_file = futures[future]\n",
    "            try:\n",
    "                fname, rows = future.result()\n",
    "                if not rows:\n",
    "                    print(f\"Skipping {fname}: protein not recognized or no interactions.\")\n",
    "                else:\n",
    "                    print(fname)\n",
    "                all_rows.extend(rows)\n",
    "            except Exception as exc:\n",
    "                print(f\"Error processing {pdb_file}: {exc}\")\n",
    "\n",
    "    df = pd.DataFrame(all_rows)\n",
    "    for col in [\"ligcoo\", \"protcoo\", \"metalcoo\", \"targetcoo\"]:\n",
    "        if col in df.columns:\n",
    "            df[col] = df[col].apply(lambda x: tuple(x) if x is not None else None)\n",
    "\n",
    "    df.to_csv(\"plip_interactions.csv\", index=False)\n",
    "\n",
    "    print(\"\\nDone.\")\n",
    "    print(\"Shape:\", df.shape)\n",
    "    print(\"\\nInteraction counts:\")\n",
    "    print(df[\"interaction_type\"].value_counts())\n",
    "    print(\"\\nProtein counts:\")\n",
    "    print(df[\"protein\"].value_counts())\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    main()"
   ]
  },
